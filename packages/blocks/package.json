{
  "name": "@marlinjai/email-editor-blocks",
  "version": "0.1.0",
  "description": "The 14 standard block types of the email editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinjai/email-editor.git",
    "directory": "packages/blocks"
  },
  "homepage": "https://github.com/marlinjai/email-editor/tree/main/packages/blocks#readme",
  "bugs": {
    "url": "https://github.com/marlinjai/email-editor/issues"
  },
  "keywords": [
    "email",
    "mjml",
    "email-editor",
    "blocks"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@marlinjai/email-editor-core": "workspace:^",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "mobx": "^6.12.0",
    "mobx-state-tree": "^6.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
