<mjml>
  <mj-head>
    <mj-custom-head-thing value="1" />
  </mj-head>
  <mj-body>
    <mj-wrapper padding="16px" background-color="#eeeeee">
      <mj-section background-color="#ffffff">
        <mj-column><mj-text>First card in a wrapper</mj-text></mj-column>
      </mj-section>
      <mj-section background-color="#ffffff">
        <mj-column><mj-text>Second card in the same wrapper</mj-text></mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section>
      <mj-column>
        <mj-product-card sku="A-17">A custom component the service does not know</mj-product-card>
        <mj-text>Text after the custom component survives.</mj-text>
        <mj-button>A button with no link</mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
