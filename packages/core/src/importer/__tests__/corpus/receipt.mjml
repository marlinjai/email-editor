<mjml>
  <mj-head>
    <mj-title>Your receipt</mj-title>
    <mj-attributes>
      <mj-text font-family="Helvetica, Arial, sans-serif" color="#333333" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .amount { font-weight: bold; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section padding="32px 24px 8px 24px">
      <mj-group>
        <mj-column width="60%" vertical-align="middle">
          <mj-image src="https://images.example.org/logo.png" alt="Example Shop" width="120px" align="left" />
        </mj-column>
        <mj-column width="40%" vertical-align="middle">
          <mj-text align="right" font-size="12px">Order #10492<br />19 September 2026</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-spacer height="16px" />
        <mj-table cellpadding="6px" font-size="14px">
          <tr style="border-bottom:1px solid #ecedee;text-align:left;">
            <th>Item</th><th>Qty</th><th style="text-align:right;">Price</th>
          </tr>
          <tr><td>Linen notebook</td><td>2</td><td class="amount" style="text-align:right;">24.00 EUR</td></tr>
          <tr><td colspan="2">Shipping</td><td class="amount" style="text-align:right;">4.90 EUR</td></tr>
        </mj-table>
        <mj-divider border-style="dashed" border-color="#999999" border-width="1px" />
        <mj-text align="right" font-size="16px"><span class="amount">Total 28.90 EUR</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fafafa" padding="16px">
      <mj-column>
        <mj-text font-size="12px" color="#777777">Questions? Reply to this mail or write to help@example.org.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
