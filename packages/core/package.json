{
  "name": "@marlinjai/email-editor-core",
  "version": "0.1.0",
  "description": "Framework-agnostic engine of the email editor: document schema, block registry, MobX State Tree store, and the server-only MJML compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinjai/email-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/marlinjai/email-editor/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/marlinjai/email-editor/issues"
  },
  "keywords": [
    "email",
    "mjml",
    "email-editor",
    "newsletter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts --clean --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "immer": "^10.0.3",
    "mjml": "^4.14.1",
    "mjml-parser-xml": "^4.18.0",
    "mjml-preset-core": "^4.18.0",
    "mobx": "^6.12.0",
    "mobx-state-tree": "^6.0.0",
    "nanoid": "^5.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/mjml": "^4.7.4",
    "htmlparser2": "^9.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
