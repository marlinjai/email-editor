{
  "name": "@marlinjai/email-editor-core",
  "version": "0.0.1",
  "description": "Framework-agnostic core engine for email editor",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts --clean --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "immer": "^10.0.3",
    "mjml": "^4.14.1",
    "mobx": "^6.12.0",
    "mobx-state-tree": "^6.0.0",
    "nanoid": "^5.0.4",
    "zod": "^3.22.4"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/mjml": "^4.7.4",
    "@types/react": "^18.2.45",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  }
}
