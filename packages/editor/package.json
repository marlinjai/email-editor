{
  "name": "@marlinjai/email-editor",
  "version": "0.1.0",
  "description": "Embeddable visual email editor (React component and vanilla factory) that produces an MJML-compilable document",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinjai/email-editor.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/marlinjai/email-editor/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/marlinjai/email-editor/issues"
  },
  "keywords": [
    "email",
    "mjml",
    "email-editor",
    "react",
    "newsletter"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format cjs,esm --dts --clean && cp ../ui/dist/styles.css ./dist/styles.css",
    "dev": "tsup src/index.ts src/react.tsx --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@marlinjai/email-editor-blocks": "workspace:^",
    "@marlinjai/email-editor-core": "workspace:^",
    "@marlinjai/email-editor-ui": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
