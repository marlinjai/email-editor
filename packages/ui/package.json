{
  "name": "@marlinjai/email-editor-ui",
  "version": "0.1.0",
  "description": "React UI of the email editor: canvas, block sidebar and property inspector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlinjai/email-editor.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/marlinjai/email-editor/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/marlinjai/email-editor/issues"
  },
  "keywords": [
    "email",
    "mjml",
    "email-editor",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss --postcss ./postcss.config.js -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:css": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss --postcss ./postcss.config.js -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marlinjai/email-editor-core": "workspace:^",
    "@radix-ui/react-dialog": "^1.0.5",
    "clsx": "^2.0.0",
    "lucide-react": "^0.563.0",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.0",
    "nanoid": "^5.0.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.24",
    "jsdom": "^24",
    "postcss": "^8.4.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
