{
  "name": "@marlinjai/email-editor-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Email editor platform with MJML compilation",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@marlinjai/clearify": "^1.11.2",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
