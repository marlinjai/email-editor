{
  "name": "@returnhypnosis/email-editor-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Email editor platform with MJML compilation",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@marlinjai/clearify": "^1.6.6",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
